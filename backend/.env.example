# Copy to .env and fill in real values. Never commit .env.
# Generate JWT_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
DATABASE_URL=sqlite:///./farm_records.db
JWT_SECRET=replace-with-a-random-32-plus-character-secret
ACCESS_TOKEN_MINUTES=720
FRONTEND_ORIGIN=http://localhost:5173
# Optional extra origins, comma-separated:
# FRONTEND_ORIGINS=https://farm-management-system-eh7.pages.dev
LOGIN_RATE_LIMIT_ATTEMPTS=10
REGISTER_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
